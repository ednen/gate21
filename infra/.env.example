# Copy to infra/.env (never commit the real file).

# At least 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=

# Pronunciation scoring: fake | azure
SPEECH_PROVIDER=fake
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Role-play: fake | gemini  (use a paid-tier key in production)
ROLEPLAY_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Daily limits per user
QUOTA_SPEECH_PER_DAY=40
QUOTA_ROLEPLAY_PER_DAY=3
